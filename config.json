{
  "userFolders": [
    "Desktop",
    "Documents",
    "Downloads",
    "Pictures",
    "Videos",
    "Music",
    "Favorites",
    "SavedGames",
    "Contacts",
    "Links"
  ],
  "userDotfiles": [
    ".ssh",
    ".gitconfig",
    ".git-credentials",
    ".aws",
    ".kube",
    ".docker\\config.json",
    ".wslconfig",
    ".npmrc",
    ".pypirc",
    ".vimrc",
    ".bashrc",
    ".zshrc"
  ],
  "appDataScopes": [
    "Roaming",
    "Local",
    "LocalLow"
  ],
  "appDataExcludeDirs": [
    "Temp",
    "tmp",
    "Cache",
    "Cache_Data",
    "Caches",
    "Code Cache",
    "GPUCache",
    "DawnCache",
    "DawnGraphiteCache",
    "DawnWebGPUCache",
    "GrShaderCache",
    "ShaderCache",
    "D3DSCache",
    "CrashDumps",
    "Crashpad",
    "SquirrelTemp",
    "Packages",
    "Microsoft\\Windows\\INetCache",
    "Microsoft\\Windows\\WebCache",
    "Microsoft\\Windows\\Explorer",
    "Microsoft\\Windows\\Temporary Internet Files",
    "Microsoft\\Edge\\User Data",
    "Google\\Chrome\\User Data",
    "BraveSoftware\\Brave-Browser\\User Data",
    "Vivaldi\\User Data",
    "Opera Software\\Opera Stable",
    "Opera Software\\Opera GX Stable",
    "Mozilla\\Firefox\\Profiles",
    "LibreWolf\\Profiles",
    "zen\\Profiles",
    "node_modules",
    "npm-cache",
    "pip\\Cache",
    "NuGet\\v3-cache",
    "NuGet\\http-cache",
    "Yarn\\Cache",
    "pnpm-store",
    "JetBrains\\*\\caches",
    "Code\\Cache",
    "Code\\CachedData",
    "Code\\CachedExtensionVSIXs",
    "Code\\User\\workspaceStorage",
    "Discord\\Cache",
    "Discord\\Code Cache",
    "Discord\\GPUCache",
    "Slack\\Cache",
    "Slack\\Code Cache",
    "Spotify\\Data",
    "Spotify\\Storage",
    "Steam\\htmlcache",
    "NVIDIA\\DXCache",
    "NVIDIA\\GLCache",
    "AMD\\DxCache",
    "Intel\\ShaderCache"
  ],
  "appDataExcludeFiles": [
    "*.tmp",
    "*.temp",
    "*.dmp",
    "*.hdmp",
    "*.mdmp",
    "*.log",
    "*.etl",
    "*.lock",
    "Thumbs.db",
    "desktop.ini",
    "ntuser.dat*",
    "UsrClass.dat*"
  ],
  "browserCacheExcludeDirs": [
    "Cache",
    "Cache_Data",
    "Code Cache",
    "GPUCache",
    "DawnCache",
    "DawnGraphiteCache",
    "DawnWebGPUCache",
    "GrShaderCache",
    "ShaderCache",
    "Service Worker\\CacheStorage",
    "Service Worker\\ScriptCache",
    "Crashpad",
    "BrowserMetrics",
    "Safe Browsing",
    "OptimizationHints",
    "ComponentCRX",
    "cache2",
    "startupCache",
    "jumpListCache",
    "thumbnails",
    "shader-cache"
  ],
  "browserCacheExcludeFiles": [
    "*.tmp",
    "*.log",
    "LOCK",
    "lockfile",
    "parent.lock",
    ".parentlock"
  ],
  "robocopyThreads": 8,
  "robocopyRetries": 2,
  "robocopyWaitSeconds": 2,
  "defaultConflictPolicy": "BackupBeforeOverwrite"
}
